## 8. API Setup + UI Assertion

Use Playwright's `request` fixture to seed test data — faster and more reliable than UI-only setup.

```typescript
test("order history shows most recent order", async ({ page, request }) => {
  // Seed via API (fast, no UI flakiness)
  const order = await request.post("/api/orders", {
    data: { sku: "LZB-001", quantity: 1 },
    headers: { Authorization: `Bearer ${process.env.TEST_API_TOKEN}` },
  });
  expect(order.ok()).toBeTruthy();
  const { orderId } = await order.json();

  // Assert UI reflects it
  await page.goto("/account/orders");
  await expect(page.getByTestId(`order-${orderId}`)).toBeVisible();
});
```

### Helpers

```typescript
// tests/helpers.ts
export function testEmail(prefix = "test"): string {
  return `${prefix}+${Date.now()}@lazboy-test.com`;
}

export async function seedProduct(
  request: APIRequestContext,
  overrides: Partial<ProductPayload> = {}
): Promise<string> {
  const res = await request.post("/api/test/products", {
    data: { name: "Test Recliner", price: 999.99, category: "seating", ...overrides },
    headers: { Authorization: `Bearer ${process.env.TEST_API_TOKEN}` },
  });
  const { sku } = await res.json();
  return sku;
}
```

