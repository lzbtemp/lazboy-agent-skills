## 5. React / JSX

```tsx
// Base component with brand variables pre-applied
import React from "react";

interface BrandCardProps {
  title: string;
  children: React.ReactNode;
  featured?: boolean;
}

export const BrandCard: React.FC<BrandCardProps> = ({ title, children, featured }) => (
  <div
    style={{
      background: "var(--color-bg)",
      borderRadius: "var(--radius-lg)",
      boxShadow: "var(--shadow-card)",
      padding: "24px",
      transition: "box-shadow 250ms cubic-bezier(0.22, 1, 0.36, 1), transform 250ms cubic-bezier(0.22, 1, 0.36, 1)",
      ...(featured && { borderTop: "3px solid var(--color-accent)" }),
    }}
    onMouseEnter={e => {
      (e.currentTarget as HTMLElement).style.boxShadow = "var(--shadow-card-hover)";
      (e.currentTarget as HTMLElement).style.transform = "translateY(-3px)";
    }}
    onMouseLeave={e => {
      (e.currentTarget as HTMLElement).style.boxShadow = "var(--shadow-card)";
      (e.currentTarget as HTMLElement).style.transform = "translateY(0)";
    }}
  >
    <h3 style={{ color: "var(--color-primary)", fontFamily: "var(--font-stack)", fontWeight: 600 }}>
      {title}
    </h3>
    <div style={{ color: "var(--color-text)", fontFamily: "var(--font-stack)" }}>
      {children}
    </div>
  </div>
);
```

- Import and use CSS variables — never hardcode hex values inline
- Prefer rounded corners (`border-radius: var(--radius-md)`) — echoes the furniture aesthetic
- Apply motion and depth guidelines from Section 8 — every component should feel polished

